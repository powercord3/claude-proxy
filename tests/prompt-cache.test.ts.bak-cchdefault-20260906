describe("stripLeadingSystemReminders", () => {
  it("strips a single well-formed leading reminder block", () => {
    expect(stripLeadingSystemReminders("<system-reminder>hello</system-reminder>\nreal text")).toBe(
      "real text",
    );
  });

  it("tolerates whitespace before and between reminder blocks", () => {
    const text =
      "  \n<system-reminder>one</system-reminder>\n\n  <system-reminder>two</system-reminder>\n\nreal prompt A";
    expect(stripLeadingSystemReminders(text)).toBe("real prompt A");
  });

  it("stops at the first thing that is not a closed reminder block", () => {
    const text = "<system-reminder>ok</system-reminder>\nthe actual user message";
    expect(stripLeadingSystemReminders(text)).toBe("the actual user message");
  });

  it("stops at an unclosed leading reminder tag instead of guessing where it would have ended", () => {
    const text = "<system-reminder>this block never closes\nmore text that looks real";
    // Under-stripping is the safe failure here: the whole malformed-and-after text stays in
    // the hash basis rather than risking eating real conversation text past a guessed end.
    expect(stripLeadingSystemReminders(text)).toBe(text);
  });

  it("keeps a well-formed reminder stripped but stops before a malformed one that follows it", () => {
    const text = "<system-reminder>ok</system-reminder>\n<system-reminder>never closes";
    expect(stripLeadingSystemReminders(text)).toBe("<system-reminder>never closes");
  });

  it("treats a tag with the wrong exact spelling as ordinary text, not a reminder to strip", () => {
    const text = "<system-reminder >not the exact open tag</system-reminder>\nafter";
    expect(stripLeadingSystemReminders(text)).toBe(text);
  });

  it("never throws and returns the empty string for empty input", () => {
    expect(stripLeadingSystemReminders("")).toBe("");
  });
});

describe("promptCacheKeyFor (B1)", () => {
  it("gives distinct prompts distinct keys", () => {
    const a = promptCacheKeyFor([{ role: "user", content: "please review pull request 42" }]);
    const b = promptCacheKeyFor([{ role: "user", content: "please review pull request 99" }]);
    expect(a).not.toBe(b);
    expect(a).toMatch(/^[0-9a-f]{24}$/);
  });

  it('returns "anon" when there is no user message', () => {
    expect(promptCacheKeyFor([{ role: "assistant", content: "hi" }])).toBe("anon");
    expect(promptCacheKeyFor([])).toBe("anon");
  });

  it("does not let a 20,124-byte common reminder swallow conversation-specific text", () => {
    // This is the exact measured shape from work order section 4: a large identical
    // <system-reminder> (the global CLAUDE.md) in front of every first user message on a host.
    const reminderBody = "x".repeat(20_124);
    const wrap = (tail: string) => `<system-reminder>${reminderBody}</system-reminder>\n${tail}`;
    const convoA: AnthropicMessage[] = [{ role: "user", content: wrap("conversation A specific text") }];
    const convoB: AnthropicMessage[] = [{ role: "user", content: wrap("conversation B specific text") }];

    // OLD BUG: conversationKey truncates to 4096 chars before the reminder even ends, so
    // both conversations hash identically. This assertion would have PASSED before the fix
    // too (it documents the bug, not the fix) -- the next assertion is the one that would
    // have FAILED against the old code.
    expect(conversationKey(convoA)).toBe(conversationKey(convoB));
    // FIXED: the reminder is stripped entirely and the full (untruncated) tail is hashed.
    expect(promptCacheKeyFor(convoA)).not.toBe(promptCacheKeyFor(convoB));
  });

  it("regression: the old 4096-char truncation no longer hides a differing suffix", () => {
    const prefix = "x".repeat(5000); // longer than the old 4096-char slice, no reminder involved
    const convoA: AnthropicMessage[] = [{ role: "user", content: `${prefix}AAA tail` }];
    const convoB: AnthropicMessage[] = [{ role: "user", content: `${prefix}BBB tail` }];

    // Would have passed before the fix too -- proves the shared prefix is long enough to
    // trigger the bug in the legacy key.
    expect(conversationKey(convoA)).toBe(conversationKey(convoB));
    // Would have FAILED before the fix: promptCacheKeyFor now hashes past the 4096-char mark.
    expect(promptCacheKeyFor(convoA)).not.toBe(promptCacheKeyFor(convoB));
  });

  it("strips multiple leading reminder blocks before hashing", () => {
    const build = (tail: string) =>
      `<system-reminder>one</system-reminder>\n\n<system-reminder>two</system-reminder>\n${tail}`;
    const a = promptCacheKeyFor([{ role: "user", content: build("real prompt A") }]);
    const b = promptCacheKeyFor([{ role: "user", content: build("real prompt B") }]);
    expect(a).not.toBe(b);
    expect(stripLeadingSystemReminders(build("real prompt A"))).toBe("real prompt A");
  });

  it("falls back to hashing the raw text when the stripped remainder is empty", () => {
    const onlyReminder = `<system-reminder>${"y".repeat(500)}</system-reminder>`;
    expect(stripLeadingSystemReminders(onlyReminder)).toBe("");

    const key = promptCacheKeyFor([{ role: "user", content: onlyReminder }]);
    // Documents the exact fallback mechanism (hash of the RAW text), not just "it doesn't
    // crash" -- two conversations whose entire first message is this same reminder text will
    // legitimately collide on this key, which is the documented, accepted tradeoff.
    expect(key).toBe(createHash("sha256").update(onlyReminder).digest("hex").slice(0, 24));
    expect(promptCacheKeyFor([{ role: "user", content: onlyReminder }])).toBe(key);
  });

  it("deliberately collides identical fan-out prompts on the same key (affinity, not a bug)", () => {
    const prompt = "Investigate the failing test and report back.";
    const convoA: AnthropicMessage[] = [{ role: "user", content: prompt }];
    const convoB: AnthropicMessage[] = [{ role: "user", content: prompt }];
    expect(promptCacheKeyFor(convoA)).toBe(promptCacheKeyFor(convoB));
  });

  it("hashes a first user message given as content blocks the same way as an equivalent string", () => {
    const reminder = "<system-reminder>global claude.md</system-reminder>";
    const asString: AnthropicMessage[] = [{ role: "user", content: `${reminder}\nreal question` }];
    const asBlocks: AnthropicMessage[] = [
      { role: "user", content: [{ type: "text", text: `${reminder}\nreal question` }] },
    ];
    expect(promptCacheKeyFor(asBlocks)).toBe(promptCacheKeyFor(asString));
  });
});

describe("firstUserHashDiagnostics (P0.4)", () => {
  it("returns only hashes and lengths, never content", () => {
    const reminder = `<system-reminder>${"z".repeat(300)}</system-reminder>`;
    const diag = firstUserHashDiagnostics([{ role: "user", content: `${reminder}\nreal question` }]);
    expect(Object.keys(diag).sort()).toEqual(["rawHash", "rawLen", "strippedHash", "strippedLen"]);
    expect(diag.rawHash).toMatch(/^[0-9a-f]{12}$/);
    expect(diag.strippedHash).toMatch(/^[0-9a-f]{12}$/);
    expect(diag.rawLen).toBeGreaterThan(diag.strippedLen);
    expect(diag.strippedLen).toBe("real question".length);
  });

  it("keeps the stripped hash stable even when the raw reminder wrapping differs", () => {
    const a = firstUserHashDiagnostics([
      { role: "user", content: `<system-reminder>${"a".repeat(200)}</system-reminder>\nsame question` },
    ]);
    const b = firstUserHashDiagnostics([
      { role: "user", content: `<system-reminder>${"b".repeat(9000)}</system-reminder>\nsame question` },
    ]);
    expect(a.strippedHash).toBe(b.strippedHash);
    expect(a.rawHash).not.toBe(b.rawHash);
  });

  it("handles no user message without throwing", () => {
    const diag = firstUserHashDiagnostics([]);
    expect(diag.rawLen).toBe(0);
    expect(diag.strippedLen).toBe(0);
  });
});

describe("threadIdFor", () => {
  it("formats a 24-hex key into UUID shape unchanged", () => {
    const key = promptCacheKeyFor([{ role: "user", content: "x" }]);
    expect(threadIdFor(key)).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);
  });
});

describe("reasoningKeyForCallIds (B2)", () => {
  it("returns null for an empty array", () => {
    expect(reasoningKeyForCallIds([])).toBeNull();
  });

  it("returns null when every entry is falsy", () => {
    expect(reasoningKeyForCallIds(["", undefined as unknown as string, null as unknown as string])).toBeNull();
  });

  it("is invariant to arrival order (out-of-order stream completion)", () => {
    const inOrder = reasoningKeyForCallIds(["call_a", "call_b", "call_c"]);
    const outOfOrder = reasoningKeyForCallIds(["call_c", "call_a", "call_b"]);
